{
  "manifest_version": 3,
  "name": "Axik PDF Editor — Core Alpha",
  "description": "Local PDF editing alpha: movable/resizable callouts, editable text, continuous and two-up views, page tools, safe export and print preparation.",
  "version": "0.1.3",
  "minimum_chrome_version": "120",
  "action": {
    "default_title": "Open Axik PDF Editor"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'none'"
  },
  "permissions": [
    "contextMenus"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ]
}
