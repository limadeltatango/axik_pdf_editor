{
  "manifest_version": 3,
  "name": "Axik PDF Editor — Core Alpha",
  "description": "Local PDF editor alpha: callouts, text, comments, page management, Quick Export and fixed-stock print preparation.",
  "version": "0.1.0",
  "minimum_chrome_version": "120",
  "action": {
    "default_title": "Open Axik PDF Editor"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'none'"
  },
  "permissions": [
    "contextMenus"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ]
}
